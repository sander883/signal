# ===========================================
# XAUUSD Trading Signal Bot - Configuration
# ===========================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Market Data API (Twelve Data)
# Get your free API key at: https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Alternative: Alpha Vantage
# ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Data Provider: "twelvedata" or "alphavantage"
DATA_PROVIDER=twelvedata

# Trading Configuration
RISK_PERCENT=1.5
REWARD_RATIO=2
ACCOUNT_BALANCE=10000
SPREAD_POINTS=0.30

# Active timeframes (comma-separated) - each runs independently
# Options: 1min, 5min, 15min, 30min, 1h, 4h, 1day
TIMEFRAMES=15min,1h

# Legacy (used as fallback)
PRIMARY_TIMEFRAME=15min
SECONDARY_TIMEFRAME=1h

# News Filter
NEWS_FILTER_ENABLED=true
NEWS_BUFFER_BEFORE_MIN=30
NEWS_BUFFER_AFTER_MIN=60

# Session Filter
SESSION_FILTER_ENABLED=true
# Asian session (Tokyo/Sydney, 00:00-08:00 UTC) — allowed with confidence penalty
SESSION_ASIAN_ENABLED=true
SESSION_ASIAN_PENALTY=10

# AI Agent (Minimax)
AI_AGENT_ENABLED=true
MINIMAX_API_KEY=your_minimax_api_key_here
# Model options (M2 series):
#   MiniMax-M2.7-highspeed  → Best for us: fast 100tps, latest model
#   MiniMax-M2.5-highspeed  → Good alternative, fast 100tps
#   MiniMax-M2.1-highspeed  → Cheapest, fast 100tps
#   MiniMax-M2.7            → Strongest, slower 60tps (overkill)
MINIMAX_MODEL=MiniMax-M2.7-highspeed
AI_MIN_CONFIDENCE=40
AI_FALLBACK_ALLOW=true

# Token-saving settings
AI_GATE_MIN=50
AI_GATE_MAX=84
AI_MAX_CALLS_HOUR=10
AI_DEDUPE_MIN=15

# DXY Correlation Filter
DXY_FILTER_ENABLED=true
DXY_SYMBOL=DXY
DXY_TIMEFRAME=1h

# Strategies (true/false to enable/disable)
STRATEGY_TREND=true
STRATEGY_SCALPING=true
STRATEGY_BREAKOUT=true
STRATEGY_MEAN_REVERSION=true
STRATEGY_PRICE_ACTION=true

# Logging
LOG_LEVEL=info

# Cron Schedule (default: every 15 minutes during market hours)
CRON_SCHEDULE=*/15 * * * 1-5
