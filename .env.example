# ===========================================
# XAUUSD Trading Signal Bot - Configuration
# ===========================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Market Data API (Twelve Data)
# Get your free API key at: https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Alternative: Alpha Vantage
# ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Data Provider: "twelvedata" or "alphavantage"
DATA_PROVIDER=twelvedata

# Trading Configuration
RISK_PERCENT=1.5
REWARD_RATIO=2
PRIMARY_TIMEFRAME=15min
SECONDARY_TIMEFRAME=1h

# News Filter
NEWS_FILTER_ENABLED=true
NEWS_BUFFER_BEFORE_MIN=30
NEWS_BUFFER_AFTER_MIN=60

# Session Filter
SESSION_FILTER_ENABLED=true

# Strategies (true/false to enable/disable)
STRATEGY_TREND=true
STRATEGY_SCALPING=true
STRATEGY_BREAKOUT=true
STRATEGY_MEAN_REVERSION=true
STRATEGY_PRICE_ACTION=true

# Logging
LOG_LEVEL=info

# Cron Schedule (default: every 15 minutes during market hours)
CRON_SCHEDULE=*/15 * * * 1-5
